WAGA_ENVIRONMENT=development
WAGA_DEBUG=true
WAGA_DATABASE_URL=postgresql+asyncpg://waga:waga@localhost:5432/waga
WAGA_JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
WAGA_JWT_ISSUER=waga-index
WAGA_JWT_AUDIENCE=waga-api
WAGA_ACCESS_TOKEN_MINUTES=15
WAGA_REFRESH_TOKEN_DAYS=30
WAGA_MAX_FAILED_LOGIN_ATTEMPTS=5
WAGA_LOGIN_LOCK_MINUTES=15
WAGA_PASSWORD_MIN_LENGTH=12
WAGA_PASSWORD_MAX_LENGTH=128

# Telegram bot (approved market agents only)
WAGA_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
WAGA_API_BASE_URL=http://127.0.0.1:8000/api/v1
WAGA_TELEGRAM_DRY_RUN=true
WAGA_TELEGRAM_REQUIRE_AGENT=true
# Pre-approved Telegram user IDs (comma-separated), after you meet them
WAGA_TELEGRAM_AGENT_IDS=
# Invite codes you hand out after onboarding someone
WAGA_TELEGRAM_AGENT_INVITE_CODES=WAGA-ADDIS-01

# Addis AI speech-to-text (optional — Other market voice notes)
WAGA_ADDIS_AI_API_KEY=
WAGA_ADDIS_AI_STT_URL=https://api.addisassistant.com/api/v2/stt
WAGA_ADDIS_AI_DEFAULT_LANG=am
