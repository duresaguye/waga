WAGA_ENVIRONMENT=development
WAGA_DEBUG=true
# Render sets PORT automatically for web services (default 10000).
PORT=8000
WAGA_DATABASE_URL=postgresql+asyncpg://waga:waga@localhost:5432/waga
WAGA_JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
WAGA_JWT_ISSUER=waga-index
WAGA_JWT_AUDIENCE=waga-api
WAGA_ACCESS_TOKEN_MINUTES=15
WAGA_REFRESH_TOKEN_DAYS=30
WAGA_MAX_FAILED_LOGIN_ATTEMPTS=5
WAGA_LOGIN_LOCK_MINUTES=15
WAGA_PASSWORD_MIN_LENGTH=12
WAGA_PASSWORD_MAX_LENGTH=128

# Demo admin seed (waga-seed-admin)
WAGA_SEED_ADMIN_EMAIL=admin@waga.com
WAGA_SEED_ADMIN_PASSWORD=AdminPassword12!
WAGA_SEED_ADMIN_DISPLAY_NAME=Super Admin

# Telegram bot (approved market agents only)
WAGA_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
WAGA_API_BASE_URL=http://127.0.0.1:8000/api/v1
WAGA_TELEGRAM_DRY_RUN=true
WAGA_TELEGRAM_REQUIRE_AGENT=true
# Pre-approved Telegram user IDs (comma-separated), after you meet them
WAGA_TELEGRAM_AGENT_IDS=
# Invite codes you hand out after onboarding someone
WAGA_TELEGRAM_AGENT_INVITE_CODES=WAGA-ADDIS-01

# Addis AI ? voice STT (bot) + review assist LLM (API)
WAGA_ADDIS_AI_API_KEY=
WAGA_ADDIS_AI_STT_URL=https://api.addisassistant.com/api/v2/stt
WAGA_ADDIS_AI_CHAT_URL=https://api.addisassistant.com/api/v1/chat_generate
WAGA_ADDIS_AI_DEFAULT_LANG=am
WAGA_REVIEW_AI_ENABLED=true

# Subscription billing (Chapa)
WAGA_TRIAL_DAYS=14
WAGA_PRO_EXPORTS_PER_DAY=1
WAGA_HISTORY_DAYS_MONTHLY=30
WAGA_HISTORY_DAYS_ANNUAL=90
WAGA_PUBLIC_HISTORY_DAYS=30
WAGA_PRO_MONTHLY_ETB=1600
WAGA_PRO_ANNUAL_ETB=16000
WAGA_CHAPA_TEST_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxx
WAGA_CHAPA_TEST_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxx
WAGA_CHAPA_WEBHOOK_SECRET=your-webhook-hash
WAGA_CHAPA_CALLBACK_URL=http://127.0.0.1:8000/api/v1/webhooks/chapa/callback
WAGA_CHAPA_RETURN_URL=http://localhost:5173/account/billing
WAGA_CHAPA_BASE_URL=https://api.chapa.co/v1
